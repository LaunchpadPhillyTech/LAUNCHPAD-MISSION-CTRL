model Organization {
  id               String   @id @default(uuid())
  name             String   @unique
  logoUrl          String?
  industry         String?
  partnershipDate  DateTime?
  status           String   // e.g., 'Active', 'Pending'
  description      String?
  website          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
model EmailLog {
  id        String   @id @default(uuid())
  userId    String
  to        String
  subject   String
  sentAt    DateTime @default(now())
  // No email body/content stored for privacy
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  PROGRAM_COORDINATOR
  PARTNERSHIP_MANAGER
  STAFF_USER
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String?
  googleId      String?
  fullName      String
  role          Role          @default(STAFF_USER)
  title         String?
  accessLevel   String?
  createdAt     DateTime      @default(now())
  lastLogin     DateTime?
  partners      Partner[]     @relation("CreatedBy")
  interactions  Interaction[]
  students      Student[]     @relation("AddedBy")
  activityLogs  ActivityLog[]
  emailDrafts   EmailDraft[]
  savedSearches SavedSearch[]
  emailLogs     EmailLog[]
}

model Student {
  id                    String        @id @default(uuid())
  fullName              String
  email                 String?
  partner               Partner       @relation(fields: [partnerId], references: [id])
  partnerId             String
  status                StudentStatus @default(PENDING)
  cohort                String?
  earlyReleaseEligible  Boolean       @default(false)
  addedByUser           User          @relation("AddedBy", fields: [addedById], references: [id])
  addedById             String
  addedDate             DateTime      @default(now())
  notes                 String?
  interactions          Interaction[] @relation("InteractionStudents")
}

model Partner {
  id                        String        @id @default(uuid())
  organizationName          String
  websiteUrl                String?
  schoolType                String?
  officialStatusDate        DateTime?
  courseNumber              Int?
  makeVirtualHours          Int?
  totalPaidContentSees      Int?
  partnerType               String?
  partnerStatus             String?
  currentStatusNotes        String?
  earlyReleaseForSeniors    Boolean       @default(false)
  pastCohortMembers         Json?
  originalJobNoticeDetails  String?
  tags                      String[]
  createdBy                 User          @relation("CreatedBy", fields: [createdById], references: [id])
  createdById               String
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  contacts                  Contact[]
  interactions              Interaction[]
  students                  Student[]
  emailDrafts               EmailDraft[]
  @@index([createdById])
}

enum ContactType {
  LEADERSHIP
  PRIMARY
  SECONDARY
}

model Contact {
  id          String      @id @default(uuid())
  partner     Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId   String
  contactType ContactType
  name        String
  email       String
  title       String?
  @@index([partnerId])
}

enum InteractionType {
  INFOSESSION
  TABLING
  MEETING
  OUTREACH
  INTERVIEWS
  STUDENT_APPLICATION
}

model Interaction {
  id               String            @id @default(uuid())
  partner          Partner           @relation(fields: [partnerId], references: [id])
  partnerId        String
  interactionType  InteractionType
  staff            User              @relation(fields: [staffId], references: [id])
  staffId          String
  date             DateTime
  studentCount     Int               @default(0)
  sharedNotes      String?
  needsFollowup    Boolean           @default(false)
  followupDueDate  DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  students         Student[]         @relation("InteractionStudents")
  @@index([partnerId])
  @@index([staffId])
}

enum StudentStatus {
  ACTIVE_MEMBER
  APPLICANT
  ALUMNI
  PENDING
}

model ActivityLog {
  id              String   @id @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  action          String
  targetType      String
  targetId        String?
  targetName      String?
  additionalInfo  String?
  createdAt       DateTime @default(now())
  @@index([userId])
}

model EmailDraft {
  id             String   @id @default(uuid())
  staff          User     @relation(fields: [staffId], references: [id])
  staffId        String
  partner        Partner  @relation(fields: [partnerId], references: [id])
  partnerId      String
  contactEmail   String
  subject        String
  body           String
  aiPromptUsed   String?
  isSent         Boolean  @default(false)
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  @@index([staffId])
  @@index([partnerId])
}

model SavedSearch {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  name        String
  searchType  String
  filters     Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  @@index([userId])
}
